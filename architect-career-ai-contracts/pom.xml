<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.acos.ai</groupId>
  <artifactId>architect-career-ai-contracts</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>ACOS AI Contracts</name>
  <description>Contract-first OpenAPI/AsyncAPI generation platform for the ACOS AI Platform</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <!-- Plugin versions -->
    <openapi-generator-maven-plugin.version>7.12.0</openapi-generator-maven-plugin.version>
    <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
    <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
    <versions-maven-plugin.version>2.18.0</versions-maven-plugin.version>
    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
    <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    <node.version>v20.18.0</node.version>
    <npm.version>10.8.2</npm.version>

    <!-- Dependency versions -->
    <feign.version>13.5</feign.version>
    <feign-form.version>3.8.0</feign-form.version>
    <hibernate-validator.version>8.0.2.Final</hibernate-validator.version>
    <jackson.version>2.18.2</jackson.version>
    <jakarta.annotation.version>2.1.1</jakarta.annotation.version>
    <jakarta.validation.version>3.1.0</jakarta.validation.version>
    <swagger.annotations.version>2.2.28</swagger.annotations.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.11.4</junit.version>

    <!-- Generation paths -->
    <acos.bundled.openapi>${project.build.directory}/bundled/openapi/ai-platform-v1.bundled.yaml</acos.bundled.openapi>
    <acos.generated.java>${project.build.directory}/generated/java</acos.generated.java>
    <acos.generated.python>${project.build.directory}/generated/python</acos.generated.python>
    <acos.generated.typescript>${project.build.directory}/generated/typescript</acos.generated.typescript>
    <acos.generated.asyncapi>${project.build.directory}/generated/asyncapi</acos.generated.asyncapi>
    <acos.artifacts.dir>${project.build.directory}/artifacts</acos.artifacts.dir>
    <acos.node.dir>${project.build.directory}/node</acos.node.dir>

    <!-- Default = generate all languages -->
    <acos.skip.java>false</acos.skip.java>
    <acos.skip.python>false</acos.skip.python>
    <acos.skip.typescript>false</acos.skip.typescript>
    <acos.skip.events>false</acos.skip.events>
    <acos.package.java>true</acos.package.java>
    <acos.package.python>true</acos.package.python>
    <acos.package.typescript>true</acos.package.typescript>

    <skipTests>true</skipTests>
    <exe.suffix/>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.openfeign</groupId>
        <artifactId>feign-core</artifactId>
        <version>${feign.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.openfeign</groupId>
        <artifactId>feign-jackson</artifactId>
        <version>${feign.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.openfeign</groupId>
        <artifactId>feign-slf4j</artifactId>
        <version>${feign.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.openfeign</groupId>
        <artifactId>feign-okhttp</artifactId>
        <version>${feign.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.openfeign.form</groupId>
        <artifactId>feign-form</artifactId>
        <version>${feign-form.version}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>${hibernate-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jdk8</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>${jakarta.annotation.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.validation</groupId>
        <artifactId>jakarta.validation-api</artifactId>
        <version>${jakarta.validation.version}</version>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations</artifactId>
        <version>${swagger.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-slf4j</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-okhttp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign.form</groupId>
      <artifactId>feign-form</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jdk8</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>career-ai-java-sdk</finalName>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>${maven-antrun-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${maven-assembly-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.8.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <filesets>
            <fileset>
              <directory>${project.basedir}/generated</directory>
              <includes>
                <include>java/**</include>
                <include>python/**</include>
                <include>typescript/**</include>
                <include>asyncapi/**</include>
              </includes>
              <excludes>
                <exclude>README.md</exclude>
              </excludes>
            </fileset>
            <fileset>
              <directory>${project.basedir}/dist</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>

      <!-- Node toolchain in validate (before contract checks) -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <configuration>
          <workingDirectory>${project.basedir}</workingDirectory>
          <installDirectory>${acos.node.dir}</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <phase>validate</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
              <npmVersion>${npm.version}</npmVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm-ci</id>
            <phase>validate</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>ci --no-fund --no-audit</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>validate-openapi</id>
            <phase>validate</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${acos.node.dir}/node/node${exe.suffix}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/validate-openapi.mjs</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>validate-asyncapi</id>
            <phase>validate</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${acos.node.dir}/node/node${exe.suffix}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/validate-asyncapi.mjs</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>bundle-openapi</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${acos.node.dir}/node/node${exe.suffix}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/bundle-openapi.mjs</argument>
              </arguments>
              <environmentVariables>
                <ACOS_BUNDLE_OUT_DIR>${project.build.directory}/bundled/openapi</ACOS_BUNDLE_OUT_DIR>
              </environmentVariables>
            </configuration>
          </execution>
          <execution>
            <id>generate-event-models</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${acos.skip.events}</skip>
              <executable>${acos.node.dir}/node/node${exe.suffix}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/generate-events.mjs</argument>
              </arguments>
              <environmentVariables>
                <ACOS_EVENTS_OUT_DIR>${acos.generated.asyncapi}</ACOS_EVENTS_OUT_DIR>
              </environmentVariables>
            </configuration>
          </execution>
          <execution>
            <id>patch-java-sources</id>
            <phase>process-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${acos.skip.java}</skip>
              <executable>${acos.node.dir}/node/node${exe.suffix}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/patch-java-sources.mjs</argument>
              </arguments>
              <environmentVariables>
                <ACOS_GENERATED_JAVA>${acos.generated.java}</ACOS_GENERATED_JAVA>
              </environmentVariables>
            </configuration>
          </execution>
          <execution>
            <id>validate-python-models</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${acos.skip.python}</skip>
              <executable>python</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/validate-python.py</argument>
                <argument>${acos.generated.python}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>build-typescript-sdk</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${acos.skip.typescript}</skip>
              <executable>${acos.node.dir}/node/node${exe.suffix}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/build-typescript.mjs</argument>
              </arguments>
              <environmentVariables>
                <ACOS_GENERATED_TYPESCRIPT>${acos.generated.typescript}</ACOS_GENERATED_TYPESCRIPT>
                <ACOS_NODE_DIR>${acos.node.dir}</ACOS_NODE_DIR>
              </environmentVariables>
            </configuration>
          </execution>
          <execution>
            <id>package-sdk-artifacts</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${acos.node.dir}/node/node${exe.suffix}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/maven/package-artifacts.mjs</argument>
              </arguments>
              <environmentVariables>
                <ACOS_ARTIFACTS_DIR>${acos.artifacts.dir}</ACOS_ARTIFACTS_DIR>
                <ACOS_GENERATED_PYTHON>${acos.generated.python}</ACOS_GENERATED_PYTHON>
                <ACOS_GENERATED_TYPESCRIPT>${acos.generated.typescript}</ACOS_GENERATED_TYPESCRIPT>
                <ACOS_JAVA_JAR>${project.build.directory}/career-ai-java-sdk.jar</ACOS_JAVA_JAR>
                <ACOS_PACKAGE_JAVA>${acos.package.java}</ACOS_PACKAGE_JAVA>
                <ACOS_PACKAGE_PYTHON>${acos.package.python}</ACOS_PACKAGE_PYTHON>
                <ACOS_PACKAGE_TYPESCRIPT>${acos.package.typescript}</ACOS_PACKAGE_TYPESCRIPT>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-java-sdk</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skip>${acos.skip.java}</skip>
              <inputSpec>${acos.bundled.openapi}</inputSpec>
              <generatorName>java</generatorName>
              <library>feign</library>
              <output>${acos.generated.java}</output>
              <apiPackage>com.acos.ai.contracts.api</apiPackage>
              <modelPackage>com.acos.ai.contracts.model</modelPackage>
              <invokerPackage>com.acos.ai.contracts</invokerPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <skipIfSpecIsUnchanged>true</skipIfSpecIsUnchanged>
              <configOptions>
                <useJakartaEe>true</useJakartaEe>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <serializationLibrary>jackson</serializationLibrary>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <legacyDiscriminatorBehavior>false</legacyDiscriminatorBehavior>
                <disallowAdditionalPropertiesIfNotPresent>false</disallowAdditionalPropertiesIfNotPresent>
                <useBeanValidation>true</useBeanValidation>
                <performBeanValidation>true</performBeanValidation>
                <artifactId>career-ai-java-sdk</artifactId>
                <groupId>com.acos.ai</groupId>
                <artifactVersion>${project.version}</artifactVersion>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-python-sdk</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skip>${acos.skip.python}</skip>
              <inputSpec>${acos.bundled.openapi}</inputSpec>
              <generatorName>python</generatorName>
              <output>${acos.generated.python}</output>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <skipIfSpecIsUnchanged>true</skipIfSpecIsUnchanged>
              <configOptions>
                <packageName>acos_ai_contracts</packageName>
                <projectName>career-ai-python-sdk</projectName>
                <packageVersion>${project.version}</packageVersion>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-typescript-sdk</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skip>${acos.skip.typescript}</skip>
              <inputSpec>${acos.bundled.openapi}</inputSpec>
              <generatorName>typescript-axios</generatorName>
              <output>${acos.generated.typescript}</output>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <skipIfSpecIsUnchanged>true</skipIfSpecIsUnchanged>
              <configOptions>
                <npmName>@acos/ai-contracts</npmName>
                <npmVersion>${project.version}</npmVersion>
                <supportsES6>true</supportsES6>
                <withSeparateModelsAndApi>true</withSeparateModelsAndApi>
                <apiPackage>api</apiPackage>
                <modelPackage>models</modelPackage>
                <enumPropertyNaming>UPPERCASE</enumPropertyNaming>
                <stringEnums>true</stringEnums>
                <useSingleRequestParameter>true</useSingleRequestParameter>
                <withInterfaces>true</withInterfaces>
                <usePromise>true</usePromise>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>ensure-java-source-root</id>
            <phase>process-sources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${acos.generated.java}/src/main/java"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>copy-event-schemas</id>
            <phase>process-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${acos.generated.python}/event_schemas"/>
                <mkdir dir="${acos.generated.typescript}/event_schemas"/>
                <mkdir dir="${acos.generated.java}/event_schemas"/>
                <copy todir="${acos.generated.python}/event_schemas" failonerror="false">
                  <fileset dir="${acos.generated.asyncapi}"/>
                </copy>
                <copy todir="${acos.generated.typescript}/event_schemas" failonerror="false">
                  <fileset dir="${acos.generated.asyncapi}"/>
                </copy>
                <copy todir="${acos.generated.java}/event_schemas" failonerror="false">
                  <fileset dir="${acos.generated.asyncapi}"/>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-java-sources</id>
            <phase>process-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${acos.generated.java}/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <skipMain>${acos.skip.java}</skipMain>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
