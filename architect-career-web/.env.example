# Public app configuration (exposed to the browser via Vite)
VITE_APP_NAME=ACOS
VITE_APP_VERSION=0.1.0

# API base URL used by Axios.
# Leave empty in development to use the Vite proxy (/api → backend).
VITE_API_BASE_URL=

# Backend target for the Vite development proxy
VITE_API_PROXY_TARGET=http://localhost:8080

# Enable React Query Devtools in development
VITE_ENABLE_QUERY_DEVTOOLS=true

# Frontend feature toggle mirroring backend ai.platform.enabled
VITE_AI_PLATFORM_ENABLED=false
