    <!-- Hibernate-safe entity equals uses class identity after instanceof BaseEntity. -->
    <Match>
        <Class name="com.acos.common.persistence.BaseEntity"/>
        <Bug pattern="BC_EQUALS_METHOD_SHOULD_WORK_FOR_ALL_OBJECTS"/>
    </Match>
    <!-- Spring-managed ObjectMapper singleton is intentionally injected and retained. -->
    <Match>
        <Class name="com.acos.auth.security.JsonAuthenticationEntryPoint"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.acos.auth.security.JsonAccessDeniedHandler"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
