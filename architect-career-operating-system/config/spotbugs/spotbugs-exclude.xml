<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Class name="~.*\..*Test"/>
    </Match>
    <Match>
        <Class name="~.*\..*IT"/>
    </Match>
    <Match>
        <Source name="~.*package-info\.java"/>
    </Match>
    <!-- Records with List.copyOf / Set.copyOf still trigger false-positive representation exposure. -->
    <Match>
        <Class name="com.acos.common.api.ApiError"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.acos.auth.dto.LoginResponse"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.acos.knowledge.dto.KnowledgeNoteRequest"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Integration Feign DTOs are immutable transport records; SpotBugs flags List/Map components. -->
    <Match>
        <Class name="~com\.acos\.integration\.dto\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- JPA associations intentionally expose the managed User reference. -->
    <Match>
        <Class name="com.acos.auth.entity.RefreshToken"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.acos.knowledge.entity.KnowledgeNote"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Spring-managed collaborators are intentionally injected and retained. -->
    <Match>
        <Class name="com.acos.knowledge.controller.KnowledgeController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
