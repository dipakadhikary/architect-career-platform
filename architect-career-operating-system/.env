# Local infrastructure defaults for Docker Compose and Spring Boot.
# Copy to .env and adjust as needed. Never commit .env.
ACOS_JWT_SECRET=change-me-to-a-secure-secret-key-at-least-32-chars
ACOS_JWT_ISSUER=acos-platform-local
ACOS_JWT_ACCESS_TTL=15m
ACOS_JWT_REFRESH_TTL=7d

ACOS_DB_NAME=postgres
ACOS_DB_USER=postgres
ACOS_DB_PASSWORD=postgres
ACOS_DB_HOST=localhost
ACOS_DB_PORT=5432

ACOS_PGADMIN_EMAIL=admin@acos.local
ACOS_PGADMIN_PASSWORD=admin
ACOS_PGADMIN_PORT=5050

AI_PLATFORM_ENABLED=true
AI_PLATFORM_BASE_URL="http://localhost:8090"
